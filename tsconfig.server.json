{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist-server",
    "types": ["node"],
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": ["server", "lib", "scripts", "test", "vitest.config.ts"],
  "exclude": ["dist", "dist-server", "node_modules"]
}
